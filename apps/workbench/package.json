{
  "name": "@gujian/workbench",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node sync-pdfjs-assets.mjs && tsc -b && vite build",
    "dev": "node sync-pdfjs-assets.mjs && vite --host 127.0.0.1 --port 5173 --strictPort",
    "start": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@gujian/application": "workspace:*",
    "@gujian/domain": "workspace:*",
    "@gujian/infrastructure": "workspace:*",
    "dxf-parser": "1.1.2",
    "lucide-react": "0.539.0",
    "pdfjs-dist": "6.2.108",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "three": "0.185.1",
    "zod": "4.0.17"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.4",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "4.7.0",
    "fake-indexeddb": "6.2.5",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "vite": "7.1.1",
    "vitest": "3.2.4"
  }
