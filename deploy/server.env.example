# 复制为 /etc/gujian/server.env 并填入真实值；chmod 600
# Kimi 密钥只存在这台服务器上，绝不进仓库、不进前端
KIMI_API_KEY=填你的密钥

# 公网模式：反代转发的 Host 与浏览器 Origin
GUJIAN_PUBLIC_HOST=heritage.jiajiajiang.com
GUJIAN_ALLOWED_ORIGIN=https://heritage.jiajiajiang.com

# 每日限额（不填用默认：助手单 IP 40 次/全站 400 次，生成单 IP 8 次/全站 40 次）
# GUJIAN_DAILY_ASSISTANT_PER_IP=40
# GUJIAN_DAILY_ASSISTANT_TOTAL=400
# GUJIAN_DAILY_JOBS_PER_IP=8
# GUJIAN_DAILY_JOBS_TOTAL=40

# Linux venv 的解释器（setup 脚本建在这里）
GUJIAN_PYTHON=/opt/gujian/app/workers/cad/.venv/bin/python
